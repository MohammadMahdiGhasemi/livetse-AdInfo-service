APP_NAME=livetse-promotion-service
APP_ENV=production
APP_VERSION=1.0.0

DATABASE_URL=postgresql+asyncpg://promotion_user:CHANGE_ME@postgres:5432/promotion
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
AUTO_CREATE_SCHEMA=false

# Legacy variable name kept for compatibility. Use a random 32+ byte secret.
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_ADMIN_SECRET
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REQUIRE_EXP=true
JWT_LEEWAY_SECONDS=10

UPLOAD_SERVICE_URL=http://upload-service:8000
UPLOAD_SERVICE_API_KEY=CHANGE_TO_A_LONG_RANDOM_UPLOAD_API_KEY
UPLOAD_CONNECT_TIMEOUT=5
UPLOAD_READ_TIMEOUT=60
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif
BANNERS_UPLOAD_FOLDER=banners
ANNOUNCEMENTS_UPLOAD_FOLDER=announcements
ADS_UPLOAD_FOLDER=ads

LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_DOCS=false
CORS_ORIGINS=https://example.com
TRUSTED_HOSTS=api.example.com
