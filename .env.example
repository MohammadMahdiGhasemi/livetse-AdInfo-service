APP_NAME=livetse-promotion-service
APP_ENV=production
APP_VERSION=1.1.0

DATABASE_URL=postgresql+asyncpg://promotion_user:CHANGE_ME@postgres:5432/promotion
REDIS_URL=
BASE_URL=https://promotion.example.com
DATABASE_NAME=promotion

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
AUTO_CREATE_SCHEMA=false

# JWT verification. Prefer JWKS so key rotation works automatically.
JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Alternative to JWT_JWKS_URL (normally leave empty when JWKS is configured):
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REQUIRE_EXP=true
JWT_LEEWAY_SECONDS=10
JWT_JWKS_CACHE_TTL_SECONDS=300
JWT_JWKS_CONNECT_TIMEOUT=3
JWT_JWKS_READ_TIMEOUT=5
ADMIN_ROLES=ADMIN,SUPER_ADMIN

UPLOAD_SERVICE_URL=https://upload.example.com
UPLOAD_SERVICE_API_KEY=CHANGE_TO_A_LONG_RANDOM_UPLOAD_API_KEY
UPLOAD_CONNECT_TIMEOUT=5
UPLOAD_READ_TIMEOUT=60
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif
BANNERS_UPLOAD_FOLDER=banners
ANNOUNCEMENTS_UPLOAD_FOLDER=announcements
ADS_UPLOAD_FOLDER=ads

LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_DOCS=false
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=promotion.example.com
