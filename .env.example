# =============================================================================
# Livetse Promotion Service - production environment template
# Copy to .env only for local/staging use. In production prefer secret/env injection.
# =============================================================================

APP_NAME=livetse-promotion-service
APP_ENV=production
APP_VERSION=1.2.0
BASE_URL=https://promotion.example.com

# Business module feature flags
ENABLE_ANNOUNCEMENTS=true
ENABLE_BANNERS=true
ENABLE_ADS=true
ENABLE_UPLOADS=true
ENABLE_DOCS=false

# Database
DATABASE_URL=postgresql+asyncpg://promotion_user:CHANGE_ME@postgres:5432/promotion
DATABASE_NAME=promotion
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
AUTO_CREATE_SCHEMA=false
HEALTH_READY_DB_CHECK_ENABLED=true

# Redis / rate limit
# For multi-worker/multi-instance production use RATE_LIMIT_BACKEND=redis.
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
REDIS_HEALTH_CHECK_INTERVAL=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PREFIX=promotion:ratelimit
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_EXEMPT_PATHS=/health/live,/health/ready

# JWT verification - prefer JWKS for automatic key rotation
JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Alternative to JWKS; normally leave empty when JWKS is configured
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_REQUIRE_EXP=true
JWT_LEEWAY_SECONDS=10
JWT_JWKS_CACHE_TTL_SECONDS=300
JWT_JWKS_CONNECT_TIMEOUT=3
JWT_JWKS_READ_TIMEOUT=5
ADMIN_ROLES=ADMIN,SUPER_ADMIN

# Upload service
UPLOAD_SERVICE_URL=https://upload.example.com
UPLOAD_SERVICE_API_KEY=CHANGE_TO_A_LONG_RANDOM_UPLOAD_API_KEY
UPLOAD_CONNECT_TIMEOUT=5
UPLOAD_READ_TIMEOUT=60
UPLOAD_MAX_CONNECTIONS=50
UPLOAD_MAX_KEEPALIVE_CONNECTIONS=20
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif
BANNERS_UPLOAD_FOLDER=banners
ANNOUNCEMENTS_UPLOAD_FOLDER=announcements
ADS_UPLOAD_FOLDER=ads

# Logging
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=true
LOG_ACCESS_ENABLED=true
LOG_SQL_ENABLED=false
LOG_UVICORN_ACCESS_ENABLED=false

# HTTP middleware
ENABLE_REQUEST_CONTEXT=true
ENABLE_SECURITY_HEADERS=true
ENABLE_GZIP=true
GZIP_MINIMUM_SIZE=1024
ENABLE_CORS=true
CORS_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
ENABLE_TRUSTED_HOSTS=true
TRUSTED_HOSTS=promotion.example.com

# Ads placement behavior
ADS_POSITION_CONFLICT_CHECK_ENABLED=true
ADS_MIN_POSITION=1
ADS_MAX_POSITION=100

# Runtime container settings used by Dockerfile
PORT=8000
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=127.0.0.1
